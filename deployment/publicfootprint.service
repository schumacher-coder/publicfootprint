[Unit]
Description=PublicFootprint Next.js Application
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/thomas/projects/publicfootprint/apps/main
Environment="NODE_ENV=production"
Environment="PORT=3003"
EnvironmentFile=/home/thomas/projects/publicfootprint/apps/main/.env
ExecStart=/usr/bin/node /home/thomas/projects/publicfootprint/apps/main/node_modules/.bin/next start -p 3003
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=publicfootprint

[Install]
WantedBy=multi-user.target
